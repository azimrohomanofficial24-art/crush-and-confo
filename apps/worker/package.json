{
  "name": "@crush-and-confo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx ../../scripts/seed.ts",
    "seed:admin": "tsx ../../scripts/seed-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.44.3",
    "hono": "^4.6.14",
    "zod": "^3.23.8",
    "@crush-and-confo/shared": "*",
    "@crush-and-confo/validation": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "argon2": "^0.41.1"
  }
}
