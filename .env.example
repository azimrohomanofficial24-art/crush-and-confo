# Crush and Confo — local environment template.
# Copy to .env (never commit .env) and fill in values for LOCAL development only.
# Production secrets live in Cloudflare (wrangler secret put) and GitHub Actions
# secrets — never in this file, never in git. No real secrets are in this file.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:5173
# Local SQLite file used by the worker dev server (Agent B). NOT the live D1.
DATABASE_URL=file:./.dev.db

# --- Auth / sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_SECRET

# --- Email (Resend — DEV MODE ONLY) ---
# In dev, emails are logged, not sent. See docs/EMAIL.md.
# Production sending requires a verified domain + a real key in Cloudflare secrets.
RESEND_API_KEY=
RESEND_DEV_MODE=true
EMAIL_FROM=Crush and Confo <noreply@example.com>

# --- Cloudflare bindings (names must match wrangler.jsonc) ---
D1_DATABASE_NAME=crush-and-confo-db
D1_DATABASE_ID=
R2_BUCKET_NAME=crush-and-confo-uploads
KV_NAMESPACE_NAME=crush-and-confo-kv
KV_NAMESPACE_ID=

# --- Admin seed (first admin account) ---
# Used by `npm run seed:admin`. The script prints a one-time password to the
# terminal only — never commit it, never put a real password here.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_NAME=Site Admin
